from pathlib import Path
from urllib.request import Request, urlopen
import hashlib
import shutil
import zipfile

import pandas as pd
from IPython.display import display


# ============================================================
# 1. BAIXAR E IDENTIFICAR A FONTE
# ============================================================

URL = (
    "https://download.inep.gov.br/microdados/"
    "microdados_censo_da_educacao_superior_2015.zip"
)

caminho_zip = Path(
    "/content/microdados_censo_da_educacao_superior_2015.zip"
)

if not caminho_zip.exists():
    print("Baixando os microdados do Inep...")

    requisicao = Request(
        URL,
        headers={"User-Agent": "Mozilla/5.0"}
    )

    with urlopen(requisicao, timeout=300) as resposta:
        with open(caminho_zip, "wb") as arquivo:
            shutil.copyfileobj(resposta, arquivo)

    print("Download concluído.")

else:
    print("O ZIP já está disponível no Colab.")


def calcular_sha256(caminho):
    resumo = hashlib.sha256()

    with open(caminho, "rb") as arquivo:
        for bloco in iter(
            lambda: arquivo.read(1024 * 1024),
            b""
        ):
            resumo.update(bloco)

    return resumo.hexdigest()


sha256 = calcular_sha256(caminho_zip)

print("Arquivo:", caminho_zip.name)
print("SHA-256:", sha256)


# ============================================================
# 2. ABRIR E PREPARAR OS DADOS
# ============================================================

colunas_idade = [
    "QT_ING_0_17",
    "QT_ING_18_24",
    "QT_ING_25_29",
    "QT_ING_30_34",
    "QT_ING_35_39",
    "QT_ING_40_49",
    "QT_ING_50_59",
    "QT_ING_60_MAIS"
]

colunas_30_mais = [
    "QT_ING_30_34",
    "QT_ING_35_39",
    "QT_ING_40_49",
    "QT_ING_50_59",
    "QT_ING_60_MAIS"
]

colunas = [
    "TP_REDE",
    "TP_MODALIDADE_ENSINO",
    "CO_CINE_ROTULO",
    "QT_ING",
    "QT_ING_DIURNO",
    "QT_ING_NOTURNO"
] + colunas_idade

with zipfile.ZipFile(caminho_zip) as arquivo_zip:
    nome_csv = next(
        nome
        for nome in arquivo_zip.namelist()
        if nome.upper().endswith(
            "MICRODADOS_CADASTRO_CURSOS_2015.CSV"
        )
    )

    with arquivo_zip.open(nome_csv) as arquivo_csv:
        dados = pd.read_csv(
            arquivo_csv,
            sep=";",
            encoding="latin1",
            usecols=colunas,
            na_values=["."],
            low_memory=False,
            dtype={"CO_CINE_ROTULO": "string"}
        )

colunas_numericas = [
    "QT_ING",
    "QT_ING_DIURNO",
    "QT_ING_NOTURNO"
] + colunas_idade

for coluna in colunas_numericas:
    dados[coluna] = (
        pd.to_numeric(
            dados[coluna],
            errors="coerce"
        )
        .fillna(0)
        .astype("int64")
    )

dados["CO_CINE_ROTULO"] = (
    dados["CO_CINE_ROTULO"]
    .str.replace('"', "", regex=False)
    .str.strip()
)

dados["modalidade"] = (
    dados["TP_MODALIDADE_ENSINO"]
    .map({
        1: "Presencial",
        2: "EaD"
    })
)

dados["rede"] = (
    dados["TP_REDE"]
    .map({
        1: "Pública",
        2: "Privada"
    })
)

dados["ingressantes_30_mais"] = (
    dados[colunas_30_mais].sum(axis=1)
)

print(f"Linhas analisadas: {len(dados):,}")


# ============================================================
# 3. CHECAGENS
# ============================================================

total_ingressantes = int(
    dados["QT_ING"].sum()
)

total_30_mais = int(
    dados["ingressantes_30_mais"].sum()
)

total_faixas = int(
    dados[colunas_idade].sum().sum()
)

assert total_ingressantes == 2_922_400, (
    "O total de ingressantes não corresponde "
    "ao resultado esperado."
)

assert total_30_mais == 784_622, (
    "O total de ingressantes 30+ não corresponde "
    "ao resultado esperado."
)

assert total_faixas == total_ingressantes, (
    "As faixas etárias não somam o total "
    "de ingressantes."
)

checagens = pd.DataFrame([
    {
        "checagem": "Total de ingressantes",
        "valor": total_ingressantes,
        "status": "OK"
    },
    {
        "checagem": "Ingressantes com 30 anos ou mais",
        "valor": total_30_mais,
        "status": "OK"
    },
    {
        "checagem": "Soma das faixas etárias",
        "valor": total_faixas,
        "status": "OK"
    }
])

print("\nCHECAGENS")
display(checagens)


# ============================================================
# 4. RESULTADO GERAL E FAIXAS ETÁRIAS
# ============================================================

nomes_faixas = {
    "QT_ING_0_17": "Até 17",
    "QT_ING_18_24": "18 a 24",
    "QT_ING_25_29": "25 a 29",
    "QT_ING_30_34": "30 a 34",
    "QT_ING_35_39": "35 a 39",
    "QT_ING_40_49": "40 a 49",
    "QT_ING_50_59": "50 a 59",
    "QT_ING_60_MAIS": "60 ou mais"
}

resumo_geral = pd.DataFrame([{
    "ano": 2015,
    "total_ingressantes": total_ingressantes,
    "ingressantes_30_mais": total_30_mais,
    "percentual_30_mais": (
        total_30_mais / total_ingressantes
    )
}])

idade_brasil = (
    dados[colunas_idade]
    .sum()
    .rename_axis("variavel")
    .reset_index(name="ingressantes")
)

idade_brasil["faixa_etaria"] = (
    idade_brasil["variavel"]
    .map(nomes_faixas)
)

idade_brasil["percentual_total"] = (
    idade_brasil["ingressantes"]
    / total_ingressantes
)

idade_brasil = idade_brasil[
    [
        "faixa_etaria",
        "ingressantes",
        "percentual_total"
    ]
]

print("\nRESUMO GERAL")
display(resumo_geral)

print("\nINGRESSANTES POR FAIXA ETÁRIA")
display(idade_brasil)


# ============================================================
# 5. MODALIDADE E REDE
# ============================================================

resumo_modalidade_rede = (
    dados
    .groupby(
        ["modalidade", "rede"],
        as_index=False
    )
    .agg(
        total_ingressantes=(
            "QT_ING",
            "sum"
        ),
        ingressantes_30_mais=(
            "ingressantes_30_mais",
            "sum"
        )
    )
)

resumo_modalidade_rede[
    "percentual_30_mais"
] = (
    resumo_modalidade_rede[
        "ingressantes_30_mais"
    ]
    / resumo_modalidade_rede[
        "total_ingressantes"
    ]
)

resumo_modalidade_rede[
    "participacao_total_30_mais"
] = (
    resumo_modalidade_rede[
        "ingressantes_30_mais"
    ]
    / total_30_mais
)

print("\nMODALIDADE × REDE")
display(resumo_modalidade_rede)


# ============================================================
# 6. FAIXA ETÁRIA × MODALIDADE × REDE
# ============================================================

faixa_modalidade_rede = dados.melt(
    id_vars=[
        "modalidade",
        "rede"
    ],
    value_vars=colunas_idade,
    var_name="variavel",
    value_name="ingressantes"
)

faixa_modalidade_rede["faixa_etaria"] = (
    faixa_modalidade_rede["variavel"]
    .map(nomes_faixas)
)

faixa_modalidade_rede = (
    faixa_modalidade_rede
    .groupby(
        [
            "faixa_etaria",
            "modalidade",
            "rede"
        ],
        as_index=False
    )["ingressantes"]
    .sum()
)

faixa_modalidade_rede[
    "percentual_no_grupo"
] = (
    faixa_modalidade_rede
    .groupby(
        ["modalidade", "rede"]
    )["ingressantes"]
    .transform(
        lambda valores: (
            valores / valores.sum()
        )
    )
)

print("\nFAIXA ETÁRIA × MODALIDADE × REDE")
display(faixa_modalidade_rede)


# ============================================================
# 7. PEDAGOGIA E SERVIÇO SOCIAL
# ============================================================

cursos_pauta = {
    "0113P01": "Pedagogia",
    "0923S01": "Serviço Social"
}

dados["curso"] = (
    dados["CO_CINE_ROTULO"]
    .map(cursos_pauta)
)

dados_cursos = dados[
    dados["curso"].notna()
].copy()

resumo_cursos = (
    dados_cursos
    .groupby(
        "curso",
        as_index=False
    )
    .agg(
        total_ingressantes=(
            "QT_ING",
            "sum"
        ),
        ingressantes_30_mais=(
            "ingressantes_30_mais",
            "sum"
        )
    )
)

resumo_cursos[
    "percentual_30_mais"
] = (
    resumo_cursos[
        "ingressantes_30_mais"
    ]
    / resumo_cursos[
        "total_ingressantes"
    ]
)

cursos_modalidade = (
    dados_cursos
    .groupby(
        [
            "curso",
            "modalidade"
        ],
        as_index=False
    )
    .agg(
        total_ingressantes=(
            "QT_ING",
            "sum"
        ),
        ingressantes_30_mais=(
            "ingressantes_30_mais",
            "sum"
        )
    )
)

cursos_modalidade[
    "percentual_30_mais"
] = (
    cursos_modalidade[
        "ingressantes_30_mais"
    ]
    / cursos_modalidade[
        "total_ingressantes"
    ]
)

faixas_cursos = dados_cursos.melt(
    id_vars=[
        "curso",
        "modalidade"
    ],
    value_vars=colunas_idade,
    var_name="variavel",
    value_name="ingressantes"
)

faixas_cursos["faixa_etaria"] = (
    faixas_cursos["variavel"]
    .map(nomes_faixas)
)

faixas_cursos = (
    faixas_cursos
    .groupby(
        [
            "curso",
            "faixa_etaria",
            "modalidade"
        ],
        as_index=False
    )["ingressantes"]
    .sum()
)

print("\nRESUMO DOS CURSOS")
display(resumo_cursos)

print("\nCURSOS POR MODALIDADE")
display(cursos_modalidade)

print("\nCURSOS POR FAIXA ETÁRIA")
display(faixas_cursos)


# ============================================================
# 8. TURNOS DOS CURSOS PRESENCIAIS
# ============================================================
# A base não permite cruzar diretamente idade e turno.

presencial = dados[
    dados["modalidade"] == "Presencial"
]

turnos_presenciais = pd.DataFrame({
    "turno": [
        "Diurno",
        "Noturno"
    ],
    "ingressantes": [
        presencial[
            "QT_ING_DIURNO"
        ].sum(),
        presencial[
            "QT_ING_NOTURNO"
        ].sum()
    ]
})

turnos_presenciais["percentual"] = (
    turnos_presenciais["ingressantes"]
    / turnos_presenciais[
        "ingressantes"
    ].sum()
)

print("\nTURNOS DOS CURSOS PRESENCIAIS")
display(turnos_presenciais)


# ============================================================
# 9. EXPORTAR OS RESULTADOS
# ============================================================

pasta_resultados = Path(
    "/content/resultados_2015"
)

pasta_resultados.mkdir(
    parents=True,
    exist_ok=True
)

metadados_fonte = pd.DataFrame([{
    "fonte": "Inep",
    "ano": 2015,
    "url": URL,
    "arquivo": caminho_zip.name,
    "sha256": sha256
}])

tabelas = {
    "checagens_2015.csv":
        checagens,

    "fonte_2015.csv":
        metadados_fonte,

    "resumo_geral_2015.csv":
        resumo_geral,

    "idade_brasil_2015.csv":
        idade_brasil,

    "modalidade_rede_2015.csv":
        resumo_modalidade_rede,

    "faixa_modalidade_rede_2015.csv":
        faixa_modalidade_rede,

    "resumo_cursos_2015.csv":
        resumo_cursos,

    "cursos_modalidade_2015.csv":
        cursos_modalidade,

    "cursos_por_faixa_2015.csv":
        faixas_cursos,

    "turnos_presenciais_2015.csv":
        turnos_presenciais
}

for nome_arquivo, tabela in tabelas.items():
    tabela.to_csv(
        pasta_resultados / nome_arquivo,
        index=False,
        encoding="utf-8-sig"
    )

caminho_excel = (
    pasta_resultados
    / "resultados_inep_2015.xlsx"
)

with pd.ExcelWriter(
    caminho_excel,
    engine="openpyxl"
) as writer:

    resumo_geral.to_excel(
        writer,
        sheet_name="Resumo geral",
        index=False
    )

    idade_brasil.to_excel(
        writer,
        sheet_name="Faixas etárias",
        index=False
    )

    resumo_modalidade_rede.to_excel(
        writer,
        sheet_name="Modalidade e rede",
        index=False
    )

    faixa_modalidade_rede.to_excel(
        writer,
        sheet_name="Faixa modalidade rede",
        index=False
    )

    resumo_cursos.to_excel(
        writer,
        sheet_name="Resumo dos cursos",
        index=False
    )

    cursos_modalidade.to_excel(
        writer,
        sheet_name="Cursos modalidade",
        index=False
    )

    faixas_cursos.to_excel(
        writer,
        sheet_name="Cursos por faixa",
        index=False
    )

    turnos_presenciais.to_excel(
        writer,
        sheet_name="Turnos presenciais",
        index=False
    )

    checagens.to_excel(
        writer,
        sheet_name="Checagens",
        index=False
    )

    metadados_fonte.to_excel(
        writer,
        sheet_name="Fonte",
        index=False
    )

print("\nANÁLISE CONCLUÍDA")
print("Resultados salvos em:", pasta_resultados)
print("Planilha:", caminho_excel)
